---
import Icon from './Icon.astro';
import { NAP } from '../data/site';
---
<aside class="side-card dark" aria-labelledby="side-contact-h">
  <h2 id="side-contact-h">Visit or call the office</h2>
  <ul class="info-list">
    <li><Icon name="pin" /><span><small>Office</small>14/2, 15th Cross Street, Shastri Nagar, Adyar</span></li>
    <li><Icon name="clock" /><span><small>Hours</small>Mon to Sat, 8 am to 8 pm</span></li>
    <li><Icon name="mail" /><span><small>Email</small><a href={`mailto:${NAP.email}`}>{NAP.email}</a></span></li>
  </ul>
  <a class="btn gold" href={`tel:${NAP.phoneTel}`}><Icon name="phone" /> {NAP.phone}</a>
  <a class="btn ghost-light" href={NAP.whatsappLink} rel="noopener"><Icon name="chat" /> WhatsApp</a>
  <a class="btn ghost-light" href={NAP.directionsUrl} data-directions rel="noopener"><Icon name="directions" /> Directions</a>
</aside>
