---
import Icon from './Icon.astro';
import { NAP } from '../data/site';
---
<iframe class="map map-inline" src={NAP.mapEmbed} title="Map showing the office of CA S. A. Abdul Rahim in Shastri Nagar, Adyar, Chennai" loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="600" height="360"></iframe>
<p class="btn-row map-actions">
  <a class="btn" href={NAP.directionsUrl} data-directions rel="noopener"><Icon name="directions" /> Get directions</a>
  <a class="btn alt" href={NAP.mapsUrl} rel="noopener">Open in Google Maps</a>
</p>
