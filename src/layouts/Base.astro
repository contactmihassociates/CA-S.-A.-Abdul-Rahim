---
import '../styles/global.css';
import { NAP, SITE_URL, REVIEWED_TEXT, SERVICES } from '../data/site';
import { accountingService, person, breadcrumb } from '../data/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: { name: string; path: string }[];
  schema?: object[];
  ogType?: string;
}
const { title, description, path, crumbs = [], schema = [], ogType = 'website' } = Astro.props;
const canonical = `${SITE_URL}${path}`;
const allCrumbs = [{ name: 'Home', path: '/' }, ...crumbs];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [accountingService, person, breadcrumb(allCrumbs), ...schema],
};
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/#services', label: 'Services' },
  { href: '/guides/', label: 'Guides' },
  { href: '/areas/', label: 'Areas' },
  { href: '/contact/', label: 'Contact' },
];
const year = 2026;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <meta name="theme-color" content="#1b2a4a" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/source-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/source-serif-600.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={NAP.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="CA S. A. Abdul Rahim, Chartered Accountant, Adyar, Chennai, since 1985" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <script src="/js/site.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{NAP.name}<small>{NAP.designation} · Adyar, Chennai · Since {NAP.sinceYear}</small></a>
      <nav class="nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  {allCrumbs.length > 1 && (
    <nav class="wrap crumbs" aria-label="Breadcrumb">
      <ol>
        {allCrumbs.map((c, i) => (
          <li>{i === allCrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
        ))}
      </ol>
    </nav>
  )}

  <main id="main" class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <h2>{NAP.name}</h2>
          <p class="nap">{NAP.designation}<br /><span class="nap-address">{NAP.addressLine}</span></p>
          <p>Phone: <a href={`tel:${NAP.phoneTel}`}>{NAP.phone}</a><br />
          Other phone: <a href={`tel:${NAP.phone2Tel}`}>{NAP.phone2}</a><br />
          WhatsApp: <a href={NAP.whatsappLink} rel="noopener">{NAP.whatsapp}</a><br />
          Email: <a href={`mailto:${NAP.email}`}>{NAP.email}</a></p>
          <p>{NAP.hoursText}</p>
        </div>
        <div>
          <h2>Services</h2>
          <ul>{SERVICES.slice(0, 8).map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
        </div>
        <div>
          <h2>More</h2>
          <ul>
            {SERVICES.slice(8).map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/areas/">Areas and directions</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
      <p class="disclaimer-line">General information only. Not professional advice. Content reviewed on {REVIEWED_TEXT}.<br />© {year} {NAP.name}. This website follows the guidelines of the Institute of Chartered Accountants of India for members' websites.</p>
    </div>
  </footer>

  <div class="action-bar" aria-label="Quick contact">
    <a class="btn" href={`tel:${NAP.phoneTel}`}>Call</a>
    <a class="btn alt" href={NAP.whatsappLink} rel="noopener">WhatsApp</a>
  </div>

</body>
</html>
