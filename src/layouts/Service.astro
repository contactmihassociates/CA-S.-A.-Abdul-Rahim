---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import SideContact from '../components/SideContact.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { SERVICES, GUIDES, REVIEWED_TEXT, SERVICE_TOOLS } from '../data/site';
import { faqPage, service, article } from '../data/schema';
import toolData from '../data/tools.json';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  name: string;
  lead: string;
  faqs: { q: string; a: string }[];
  related: string[];
  sources: { href: string; label: string }[];
  topic?: string;
  guide?: { published: string; modified: string };
}
const { title, description, path, h1, name, lead, faqs, related, sources, topic, guide } = Astro.props;
const all = [...SERVICES.map((s) => ({ href: s.href, label: s.label })), ...GUIDES.map((g) => ({ href: g.href, label: g.title }))];
const relatedLinks = related.map((href) => all.find((x) => x.href === href)).filter(Boolean) as { href: string; label: string }[];
const isGuide = Boolean(guide);
const schema: object[] = [isGuide ? article(h1, path, description, guide!.published, guide!.modified) : service(name, path, description)];
if (faqs.length) schema.push(faqPage(faqs));
const crumbs = isGuide ? [{ name: 'Guides', path: '/guides/' }, { name, path }] : [{ name, path }];
const group = SERVICES.find((s) => s.href === path)?.group;
const toolKeys = SERVICE_TOOLS[path] ?? (isGuide ? SERVICE_TOOLS[related.find((r) => SERVICE_TOOLS[r]) ?? ''] ?? [] : []);
const tools = toolKeys.map((k) => toolData.tools.find((t) => t.key === k)).filter(Boolean) as { key: string; label: string }[];
---
<Base title={title} description={description} path={path} crumbs={crumbs} schema={schema} ogType={isGuide ? 'article' : 'website'}>
  <PageHero crumbs={crumbs} h1={h1} eyebrow={isGuide ? 'Guide' : group ? `Services · ${group}` : 'Services'}>
    {isGuide && <p class="meta" slot="meta">By CA S. A. Abdul Rahim, Chartered Accountant · Published <time datetime={guide!.published}>29 October 2026</time> · Last reviewed <time datetime={guide!.modified}>{REVIEWED_TEXT}</time></p>}
    <p class="lead">{lead}</p>
  </PageHero>

  <div class="wrap layout">
    <article class="prose">
      <slot />

      {faqs.length > 0 && (
        <section class="faq" aria-labelledby="faq-h">
          <h2 id="faq-h">Frequently asked questions</h2>
          <div class="faq-list">
            {faqs.map((f, i) => (<details open={i === 0}><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>))}
          </div>
        </section>
      )}

      <ContactBlock topic={topic ?? name.toLowerCase()} />

      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h">Sources</h2>
        <ul>{sources.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}</ul>
        <p class="meta">Last reviewed: <time datetime="2026-10-29">{REVIEWED_TEXT}</time>. Tax law and portal forms change often. Check the official source or speak to a Chartered Accountant before acting on any of this information.</p>
      </section>
    </article>

    <div class="sidebar">
      <SideContact />
      {tools.length > 0 && (
        <nav class="side-card" aria-labelledby="side-tools-h">
          <h2 id="side-tools-h">Related calculators</h2>
          <ul>
            {path === "/income-tax-return-filing-chennai/" && <li><a href="/tools/income-tax-calculator/">Full income tax calculator, old vs new</a></li>}
            {tools.map((t) => <li><a href={`/tools/${t.key}/`}>{t.label}</a></li>)}
          </ul>
        </nav>
      )}
      <nav class="side-card" aria-labelledby="rel-h">
        <h2 id="rel-h">Related pages</h2>
        <ul>{relatedLinks.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
      </nav>
    </div>
  </div>
</Base>
