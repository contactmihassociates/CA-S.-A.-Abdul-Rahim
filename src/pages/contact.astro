---
import PageHero from '../components/PageHero.astro';
import SideContact from '../components/SideContact.astro';
import Base from '../layouts/Base.astro';
import Map from '../components/Map.astro';
import { NAP } from '../data/site';
---
<Base
  title="Contact CA S. A. Abdul Rahim, Adyar, Chennai"
  description="Address, phone, WhatsApp, email, office hours, map and directions for CA S. A. Abdul Rahim, Chartered Accountant, Shastri Nagar, Adyar, Chennai 600020."
  path="/contact/"
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <PageHero crumbs={[{ name: 'Contact', path: '/contact/' }]} h1={"Contact CA S. A. Abdul Rahim, Adyar, Chennai"} lead={"The office of CA S. A. Abdul Rahim, Chartered Accountant, is at 14/2, 15th Cross Street, Shastri Nagar, Adyar, Chennai, Tamil Nadu 600020. It is open Monday to Saturday from 8:00 am to 8:00 pm and closed on Sunday."} />
  <div class="wrap layout">
  <article class="prose">

    <dl class="facts">
      <dt>Address</dt><dd>{NAP.addressLine}</dd>
      <dt>Phone</dt><dd><a href={`tel:${NAP.phoneTel}`}>{NAP.phone}</a></dd>
      <dt>Other phone</dt><dd><a href={`tel:${NAP.phone2Tel}`}>{NAP.phone2}</a></dd>
      <dt>WhatsApp</dt><dd><a href={NAP.whatsappLink} rel="noopener">{NAP.whatsapp}</a></dd>
      <dt>Email</dt><dd><a href={`mailto:${NAP.email}`}>{NAP.email}</a></dd>
      <dt>Hours</dt><dd>Monday to Saturday, 8:00 am to 8:00 pm IST. Sunday closed.</dd>
      <dt>Languages</dt><dd>{NAP.languages.join(', ')}</dd>
    </dl>

    <h2>Map</h2>
    <Map />

    <h2>Directions</h2>
    <h3>From Adyar signal</h3>
    <p>The office is about 1 km south of Adyar signal, in Shastri Nagar. Head south from the signal towards Shastri Nagar; 15th Cross Street is inside the Shastri Nagar residential area.</p>
    <h3>From Thiruvanmiyur</h3>
    <p>The office is about 2 km north of Thiruvanmiyur. Head north towards Adyar; Shastri Nagar comes before Adyar signal.</p>
    <h3>From Besant Nagar</h3>
    <p>The office is about 1 to 1.5 km west of Besant Nagar. Shastri Nagar lies between Besant Nagar and Adyar, so head west towards Adyar.</p>
    <p>For a turn-by-turn route from where you are, use <a href={NAP.directionsUrl} data-directions rel="noopener">Get directions</a> on Google Maps. For other areas, see <a href="/areas/">areas and how to reach the office</a>.</p>

    <h2>Before you call or visit</h2>
    <p>It helps to keep your PAN, the notice or document you have a question about, and your login details for the income tax or GST portal at hand. Please do not send passwords by WhatsApp or email; they can be entered by you at the time of filing.</p>
    <p class="meta">Last reviewed: <time datetime="2026-10-29">29 October 2026</time>. Address as listed on <a href={NAP.mapsUrl} rel="noopener">Google Maps</a>. Official portals: <a href="https://www.incometax.gov.in/" rel="noopener">incometax.gov.in</a>, <a href="https://www.gst.gov.in/" rel="noopener">gst.gov.in</a>.</p>
  </article>
  <div class="sidebar"><SideContact /></div>
  </div>
</Base>
