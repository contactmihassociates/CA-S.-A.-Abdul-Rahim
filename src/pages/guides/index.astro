---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { GUIDES, SERVICES } from '../../data/site';
const crumbs = [{ name: 'Guides', path: '/guides/' }];
---
<Base
  title="Tax and Compliance Guides | CA S. A. Abdul Rahim"
  description="Plain-language guides on ITR documents, TDS on property, NRI property sales, GST registration, income tax notices and tax audit, with official sources."
  path="/guides/"
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow="Guides" h1="Tax and compliance guides" lead="These guides explain common income tax, TDS and GST tasks in plain language, step by step, with links to the official government portals. They are written by the office of CA S. A. Abdul Rahim, Chartered Accountant, Adyar, Chennai, and are general information only." />
  <section class="section">
    <div class="wrap">
      <div class="cards cards-3">
        {GUIDES.map((g) => (
          <a class="card reveal" href={g.href}>
            <span class="card-icon"><Icon name="book" /></span>
            <h2 class="card-title">{g.title}</h2>
            <p><time datetime={g.published}>29 October 2026</time></p>
            <span class="more">Read the guide</span>
          </a>
        ))}
      </div>

      <h2>Service pages</h2>
      <div class="pills light">{SERVICES.map((s) => <a href={s.href}>{s.label}</a>)}</div>
      <p class="meta">Last reviewed: <time datetime="2026-10-29">29 October 2026</time>. Official sources: <a href="https://www.incometax.gov.in/" rel="noopener">incometax.gov.in</a>, <a href="https://www.gst.gov.in/" rel="noopener">gst.gov.in</a>.</p>
    </div>
  </section>
</Base>
